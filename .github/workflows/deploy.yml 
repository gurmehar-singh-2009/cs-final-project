name: Build and Deploy TeaVM

on:
  push:
    branches:
      - main
  workflow_dispatch:

concurrency:
  group: github-pages
  cancel-in-progress: true

jobs:
  build:
    name: Build TeaVM
    runs-on: ubuntu-latest

    permissions:
      contents: read
      pages: write
      id-token: write

    steps:
      - name: Checkout
        uses: actions/checkout@v6

      - name: Set up Java 20
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: '20'
          cache: gradle

      - name: Make Gradle wrapper executable
        run: chmod +x ./gradlew

      - name: Check Java and Gradle
        run: |
          java -version
          ./gradlew --version

      - name: Build TeaVM JavaScript release
        run: ./gradlew :teavm:gdx_teavm_web_js_release_build --stacktrace

      - name: Verify TeaVM output
        run: |
          OUTPUT_DIR="teavm/build/dist/js/release/webapp"

          echo "Checking: $OUTPUT_DIR"

          if [ ! -d "$OUTPUT_DIR" ]; then
            echo "::error::TeaVM output directory does not exist!"
            echo
            echo "Contents of teavm/build:"
            find teavm/build -maxdepth 8 -print 2>/dev/null | sort || true
            exit 1
          fi

          if [ ! -f "$OUTPUT_DIR/index.html" ]; then
            echo "::error::index.html was not generated!"
            echo
            echo "Generated files:"
            find "$OUTPUT_DIR" -maxdepth 5 -type f | sort
            exit 1
          fi

          echo "TeaVM build succeeded."
          echo
          echo "Generated files:"
          find "$OUTPUT_DIR" -maxdepth 5 -type f | sort

      - name: Configure GitHub Pages
        uses: actions/configure-pages@v5

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v4
        with:
          path: teavm/build/dist/js/release/webapp

  deploy:
    name: Deploy to GitHub Pages
    needs: build
    runs-on: ubuntu-latest

    permissions:
      pages: write
      id-token: write

    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
